[Unit]
Description=Fcitx5 Lotus Server for %i
After=systemd-modules-load.service systemd-udevd.service
Wants=systemd-modules-load.service

[Service]
User=@LOTUS_UINPUT_PROXY_USER@
Group=input

CapabilityBoundingSet=CAP_SYS_NICE
AmbientCapabilities=CAP_SYS_NICE

Type=simple

ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-lotus-server -u %i

Restart=on-failure
RestartSec=1

# Sandboxing. The server needs /dev/uinput and the input event devices, udev
# (netlink and /run/udev), the /proc entries of the target user's processes
# for the peer check, and abstract Unix sockets in the host network namespace,
# so PrivateNetwork, PrivateDevices, PrivateUsers and ProtectProc stay off.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=multi-user.target